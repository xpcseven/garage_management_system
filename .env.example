#DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# AUTH_SECRET=generate-a-long-random-string-here
# NEXTAUTH_URL=https://your-domain.com
# NEXT_WEBSITE_URL=https://your-domain.com
# AUTH_TRUST_HOST=https://your-domain.com

# API tokens
#API_ACCESS_TOKEN_TTL=15m
#API_REFRESH_TOKEN_DAYS=30

# تأكيد البريد — الأولوية لـ Gmail ثم Resend
# يتطلب تفعيل 2FA ثم إنشاء App Password من Google Account
#GMAIL_USER=your@gmail.com
#GMAIL_APP_PASSWORD=your-16-char-app-password

# في التطوير المحلي يُستخدم NEXTAUTH_URL لرابط التحقق داخل البريد
#EMAIL_BASE_URL=https://tr.ashuor.com

# اختياري (بديل)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev
