// ============================================================
// PRISMA SCHEMA â€” FINAL v4 (Production Ready)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  GARAGE_OWNER
  DRIVER
  USER
  TOURISM_OWNER
  HOTEL_OWNER
  RESTAURANT_OWNER
  FARM_OWNER
}

enum VehicleCategory {
  SEDAN
  BUS
  VAN
  MINIBUS
  SUV
  PICKUP
  COACH
}

enum HotelRoomType {
  SINGLE
  DOUBLE
  TWIN
  TRIPLE
  SUITE
  FAMILY
}

enum FarmOccasionType {
  FAMILY
  YOUTH
  WEDDING
  OTHER
}

enum GarageRole {
  GARAGE_ADMIN
  DRIVER
}

enum TransportType {
  INTERNAL
  EXTERNAL
}

enum JobType {
  DELIVERY
  PASSENGERS
  CARGO
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TourismProgramStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  BOOKED
}

enum LuggageKind {
  LARGE_BAG
  MEDIUM_BAG
  SACK
  CARTON
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
  ZAIN_CASH
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  TRIP_STARTED
  TRIP_COMPLETED
  PAYMENT_RECEIVED
  NEW_REVIEW
  GENERAL
  PARTNERSHIP_INVITE
  PARTNERSHIP_ACCEPTED
  PARTNERSHIP_REJECTED
  PARTNERSHIP_MESSAGE
  PACKAGE_INCLUDED
  NEW_GARAGE
  NEW_TOURISM_PLACE
  NEW_TOURISM_PROGRAM
  NEW_HOTEL
  NEW_RESTAURANT
  NEW_FARM
}

enum BusinessPartnerType {
  HOTEL
  RESTAURANT
  FARM
}

enum PartnershipStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  ENDED
}

enum TourismApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  LICENSE
  ID_CARD
  VEHICLE_REG
  INSURANCE
  OTHER
}

// ============================================================
// USER
// ============================================================

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  phone    String? @unique
  password String
  role     Role    @default(USER)

  avatar   String?
  isActive Boolean @default(true)
  emailVerified Boolean @default(false)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  garagesOwned  Garage[]       @relation("GarageOwner")
  memberships   GarageMember[]
  vehicles      Vehicle[]
  assignedVehicles Vehicle[]   @relation("VehicleAssignedDriver")
  bookings      Booking[]
  driverProfile DriverProfile?
  reviews       Review[]       @relation("ReviewAuthor")
  notifications Notification[]
  tripsAsDriver Trip[]         @relation("TripDriver")
  tourismProgramsAsDriver TourismProgram[] @relation("TourismProgramDriver")
  tourismProgramBookings TourismProgramBooking[]
  jobPreferences UserJobPreference[]
  tourismPlaces TourismPlace[]
  apiRefreshTokens ApiRefreshToken[]
  hotelsOwned      Hotel[]
  restaurantsOwned Restaurant[]
  farmsOwned       Farm[]
  hotelBookings    HotelBooking[]
  restaurantBookings RestaurantBooking[]
  farmBookings     FarmBooking[]
  partnershipsInvited   BusinessPartnership[] @relation("PartnershipInviter")
  partnershipsResponded BusinessPartnership[] @relation("PartnershipResponder")
  partnershipMessages   PartnershipMessage[]

  @@index([email])
  @@index([phone])
  @@index([isDeleted])
}

model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime

  @@index([email])
  @@index([token])
  @@map("verification_tokens")
}

// ØªÙØ¶ÙŠÙ„Ø§Øª Ù†ÙˆØ¹ Ø§Ù„Ù†Ù‚Ù„ Ø¹Ù†Ø¯ Ø§Ù„ØªØ³Ø¬ÙŠÙ„ (ØµØ§Ø­Ø¨ ÙƒØ±Ø§Ø¬) â€” Ø§Ù„Ø³Ø§Ø¦Ù‚ ÙŠÙØ®Ø²Ù‘ÙŽÙ† ÙÙŠ DriverJob
model UserJobPreference {
  id        String   @id @default(uuid())
  userId    String
  jobType   JobType
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobType])
  @@index([userId])
}

// ============================================================
// CITY
// ============================================================

model City {
  id       String  @id @default(uuid())
  name     String  @unique
  region   String?
  isActive Boolean @default(true)

  tripsFrom Trip[]     @relation("TripFromCity")
  tripsTo   Trip[]     @relation("TripToCity")
  tripStops TripStop[]
  tourismPlaces TourismPlace[]
  hotels      Hotel[]
  restaurants Restaurant[]
  farms       Farm[]
}

// ============================================================
// TOURISM PLACE (NEW)
// ============================================================

model TourismPlace {
  id          String   @id @default(uuid())
  name        String
  governorate String?
  description String?
  address     String?
  // Ù…ÙˆÙ‚Ø¹ Ù†ØµÙŠ/Ø±Ø§Ø¨Ø· ÙŠÙ…ÙƒÙ† ÙØªØ­Ù‡ Ø¹Ù„Ù‰ Ø§Ù„Ø®Ø±ÙŠØ·Ø© (Ù…Ø«Ø§Ù„: "Baghdad, Iraq" Ø£Ùˆ Ø±Ø§Ø¨Ø· Google Maps)
  location    String?
  imageUrl    String?

  cityId String?
  city   City? @relation(fields: [cityId], references: [id])

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  programPlaces TourismProgramPlace[]
  images        TourismPlaceImage[]

  isActive  Boolean  @default(true)
  approvalStatus TourismApprovalStatus @default(PENDING)
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@index([ownerId])
  @@index([isActive])
  @@index([approvalStatus])
}

model TourismPlaceImage {
  id             String   @id @default(uuid())
  tourismPlaceId String
  imageUrl       String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  place TourismPlace @relation(fields: [tourismPlaceId], references: [id], onDelete: Cascade)

  @@index([tourismPlaceId])
  @@index([tourismPlaceId, sortOrder])
}

// ============================================================
// GARAGE
// ============================================================

model Garage {
  id          String  @id @default(uuid())
  name        String
  description String?
  phone       String?
  address     String?
  logoUrl     String?
  isActive    Boolean @default(true)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User           @relation("GarageOwner", fields: [ownerId], references: [id])
  vehicles Vehicle[]
  members  GarageMember[]
  trips    Trip[]
  tourismPrograms TourismProgram[]
  reviews  Review[]       @relation("GarageReview")
  partnerships BusinessPartnership[]

  @@index([ownerId])
  @@index([isDeleted])
}

// ============================================================
// GARAGE MEMBER
// ============================================================

model GarageMember {
  id       String     @id @default(uuid())
  userId   String
  garageId String
  role     GarageRole
  joinedAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id])
  garage Garage @relation(fields: [garageId], references: [id])

  @@unique([userId, garageId])
  @@index([garageId])
  @@index([userId])
}

// ============================================================
// VEHICLE
// ============================================================

model Vehicle {
  id            String          @id @default(uuid())
  brand         String
  model         String
  year          Int
  plateNumber   String          @unique
  color         String?
  totalSeats    Int
  category      VehicleCategory @default(SEDAN)
  /// قالب المقاعد: { rows, cols, seats: [{n,row,col,label,isDriver?}] }
  seatLayoutJson Json?
  transportType TransportType
  isActive      Boolean         @default(true)
  /// اسم السائق للعرض (يُحدَّث من السائق المرتبط)
  driverName String?
  /// السائق المعيّن (User بدور DRIVER ومرتبط بالشركة)
  driverId   String?

  ownerId  String
  garageId String?

  owner     User              @relation(fields: [ownerId], references: [id])
  driver    User?             @relation("VehicleAssignedDriver", fields: [driverId], references: [id])
  garage    Garage?           @relation(fields: [garageId], references: [id])
  trips     Trip[]
  tourismPrograms TourismProgram[]
  documents VehicleDocument[]
  drivers   DriverVehicle[]

  @@index([ownerId])
  @@index([garageId])
  @@index([driverId])
  @@index([category])
}

// ============================================================
// DRIVER VEHICLE
// ============================================================

model DriverVehicle {
  id        String @id @default(uuid())
  driverId  String
  vehicleId String

  driver  DriverProfile @relation(fields: [driverId], references: [id])
  vehicle Vehicle       @relation(fields: [vehicleId], references: [id])

  @@unique([driverId, vehicleId])
  @@index([driverId])
  @@index([vehicleId])
}

// ============================================================
// VEHICLE DOCUMENT
// ============================================================

model VehicleDocument {
  id         String       @id @default(uuid())
  vehicleId  String
  type       DocumentType
  fileUrl    String
  expiresAt  DateTime?
  isVerified Boolean      @default(false)
  uploadedAt DateTime     @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}

// ============================================================
// DRIVER PROFILE
// ============================================================

model DriverProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  isFreelancer Boolean @default(true)
  isVerified   Boolean @default(false)
  isActive     Boolean @default(true)
  bio          String?
  location     String?
  ratingAvg    Float   @default(0)

  currentLat Decimal? @db.Decimal(10, 8)
  currentLng Decimal? @db.Decimal(11, 8)

  user            User             @relation(fields: [userId], references: [id])
  jobs            DriverJob[]
  documents       DriverDocument[]
  reviews         Review[]         @relation("DriverReview")
  locationHistory DriverLocation[]
  vehicles        DriverVehicle[]

  @@index([userId])
  @@index([isVerified])
  @@index([isActive])
}

// ============================================================
// DRIVER LOCATION
// ============================================================

model DriverLocation {
  id         String   @id @default(uuid())
  driverId   String
  lat        Decimal  @db.Decimal(10, 8)
  lng        Decimal  @db.Decimal(11, 8)
  recordedAt DateTime @default(now())

  driver DriverProfile @relation(fields: [driverId], references: [id])

  @@index([driverId, recordedAt])
}

// ============================================================
// DRIVER DOCUMENT
// ============================================================

model DriverDocument {
  id         String       @id @default(uuid())
  driverId   String
  type       DocumentType
  fileUrl    String
  expiresAt  DateTime?
  isVerified Boolean      @default(false)
  uploadedAt DateTime     @default(now())

  driver DriverProfile @relation(fields: [driverId], references: [id])

  @@index([driverId])
}

// ============================================================
// DRIVER JOB
// ============================================================

model DriverJob {
  id       String  @id @default(uuid())
  driverId String
  jobType  JobType
  isActive Boolean @default(true)

  driver DriverProfile @relation(fields: [driverId], references: [id])

  @@unique([driverId, jobType])
}

// ============================================================
// TRIP
// ============================================================

model Trip {
  id         String  @id @default(uuid())
  garageId   String?
  vehicleId  String
  driverId   String
  fromCityId String
  toCityId   String

  departureTime DateTime
  arrivalTime   DateTime?

  basePrice       Decimal @db.Decimal(10, 2)
  priceMultiplier Float   @default(1.0)

  maxSeats       Int
  availableSeats Int

  transportType TransportType
  status        TripStatus @default(SCHEDULED)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle  Vehicle @relation(fields: [vehicleId], references: [id])
  garage   Garage? @relation(fields: [garageId], references: [id])
  driver   User    @relation("TripDriver", fields: [driverId], references: [id])
  fromCity City    @relation("TripFromCity", fields: [fromCityId], references: [id])
  toCity   City    @relation("TripToCity", fields: [toCityId], references: [id])

  seats    Seat[]
  bookings Booking[]
  stops    TripStop[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([fromCityId])
  @@index([toCityId])
  @@index([departureTime])
  @@index([status])
}

// ============================================================
// TOURISM PROGRAM
// ============================================================

model TourismProgram {
  id String @id @default(uuid())

  title       String
  description String?
  notes       String?

  garageId  String
  vehicleId String
  driverId  String

  startAt DateTime
  endAt   DateTime?

  basePrice      Decimal @db.Decimal(10, 2)
  maxSeats       Int
  availableSeats Int
  status         TourismProgramStatus @default(SCHEDULED)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  garage  Garage  @relation(fields: [garageId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  User    @relation("TourismProgramDriver", fields: [driverId], references: [id])

  places   TourismProgramPlace[]
  bookings TourismProgramBooking[]
  partners TourismProgramPartner[]

  @@index([garageId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([startAt])
  @@index([status])
  @@index([isActive])
}

model TourismProgramPlace {
  id String @id @default(uuid())

  programId      String
  tourismPlaceId String
  stopOrder      Int

  program TourismProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  place   TourismPlace   @relation(fields: [tourismPlaceId], references: [id])

  @@unique([programId, tourismPlaceId])
  @@unique([programId, stopOrder])
  @@index([programId])
  @@index([tourismPlaceId])
}

model TourismProgramPartner {
  id String @id @default(uuid())

  programId     String
  partnershipId String
  partnerType   BusinessPartnerType
  stopOrder     Int      @default(0)
  notes         String?
  includedNights Int?
  mealPlan      String?
  visitWindow   String?
  priceAddon    Decimal  @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program     TourismProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  partnership BusinessPartnership @relation(fields: [partnershipId], references: [id])

  @@unique([programId, partnershipId])
  @@index([programId])
  @@index([partnershipId])
}

model TourismProgramBooking {
  id String @id @default(uuid())

  programId String
  userId    String

  status BookingStatus @default(PENDING)
  priceAtBooking Decimal @db.Decimal(10, 2)
  passengersCount Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program TourismProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([programId])
  @@index([userId])
  @@index([status])
}

// ============================================================
// TRIP STOPS (NEW)
// ============================================================

model TripStop {
  id     String @id @default(uuid())
  tripId String
  cityId String
  order  Int

  trip Trip @relation(fields: [tripId], references: [id])
  city City @relation(fields: [cityId], references: [id])

  @@index([tripId])
  @@index([cityId])
}

// ============================================================
// SEAT
// ============================================================

model Seat {
  id           String     @id @default(uuid())
  tripId       String
  seatNumber   Int
  row          Int?
  col          Int?
  label        String?
  priceModifier Decimal    @default(0.0) @db.Decimal(10, 2)
  status       SeatStatus @default(AVAILABLE)

  trip    Trip     @relation(fields: [tripId], references: [id])
  booking Booking?

  @@unique([tripId, seatNumber])
  @@index([tripId])
  @@index([status])
}

// ============================================================
// BOOKING
// ============================================================

model Booking {
  id     String @id @default(uuid())
  userId String
  tripId String
  seatId String @unique

  status BookingStatus @default(PENDING)

  priceAtBooking Decimal @db.Decimal(10, 2)

  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  trip    Trip     @relation(fields: [tripId], references: [id])
  seat    Seat     @relation(fields: [seatId], references: [id])
  payment Payment?
  review  Review?

  luggageItems BookingLuggageItem[]

  @@index([userId])
  @@index([tripId])
  @@index([status])
}

// Ø£Ù…ØªØ¹Ø© Ù…Ø³Ø§ÙØ± Ù…Ø±ØªØ¨Ø·Ø© Ø¨Ø§Ù„Ø­Ø¬Ø² â€” Ø£ÙƒØ«Ø± Ù…Ù† ØºØ±Ø¶ Ù„ÙƒÙ„ Ø­Ø¬Ø²
model BookingLuggageItem {
  id          String      @id @default(uuid())
  bookingId   String
  kind        LuggageKind
  weightKg    Decimal?    @db.Decimal(8, 2)
  dimensions  String?
  quantity    Int         @default(1)

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ============================================================
// PAYMENT (IMPROVED)
// ============================================================

model Payment {
  id        String        @id @default(uuid())
  bookingId String        @unique
  amount    Decimal       @db.Decimal(10, 2)
  currency  String        @default("IQD")
  method    PaymentMethod @default(CASH)
  provider  String?
  status    PaymentStatus @default(PENDING)
  reference String?

  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([status])
}

// ============================================================
// REVIEW
// ============================================================

model Review {
  id String @id @default(uuid())

  authorId  String
  bookingId String? @unique
  driverId  String?
  garageId  String?

  rating  Int
  comment String?

  createdAt DateTime @default(now())

  author  User           @relation("ReviewAuthor", fields: [authorId], references: [id])
  booking Booking?       @relation(fields: [bookingId], references: [id])
  driver  DriverProfile? @relation("DriverReview", fields: [driverId], references: [id])
  garage  Garage?        @relation("GarageReview", fields: [garageId], references: [id])
}

// ============================================================
// NOTIFICATION (IMPROVED)
// ============================================================

model Notification {
  id     String @id @default(uuid())
  userId String
  type   NotificationType
  title  String
  body   String

  isRead Boolean  @default(false)
  readAt DateTime?

  data Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}

// ============================================================
// HOME SLIDER (landing page â€” SUPER_ADMIN only)
// ============================================================

model TourismSliderSlide {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ============================================================
// API REFRESH TOKENS (mobile / external clients)
// ============================================================

model ApiRefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// AUDIT LOG (NEW â€” ENTERPRISE FEATURE)
// ============================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  data      Json?
  createdAt DateTime @default(now())
}

// ============================================================
// HOTEL (HOTEL_OWNER)
// ============================================================

model Hotel {
  id          String  @id @default(uuid())
  name        String
  description String?
  phone       String?
  address     String?
  location    String?
  imageUrl    String?
  isActive    Boolean @default(true)
  approvalStatus TourismApprovalStatus @default(PENDING)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  ownerId String
  cityId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User   @relation(fields: [ownerId], references: [id])
  city  City?  @relation(fields: [cityId], references: [id])
  rooms HotelRoom[]
  bookings HotelBooking[]
  images HotelImage[]
  partnerships BusinessPartnership[]

  @@index([ownerId])
  @@index([cityId])
  @@index([isActive])
  @@index([approvalStatus])
  @@index([isDeleted])
}

model HotelImage {
  id        String   @id @default(uuid())
  hotelId   String
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([hotelId, sortOrder])
}

model HotelRoom {
  id         String        @id @default(uuid())
  hotelId    String
  roomNumber String
  roomType   HotelRoomType @default(DOUBLE)
  capacity   Int           @default(2)
  pricePerNight Decimal    @db.Decimal(10, 2)
  amenities  String?
  description String?
  isActive   Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel    Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookings HotelBooking[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId])
  @@index([isActive])
}

model HotelBooking {
  id     String @id @default(uuid())
  userId String
  hotelId String
  roomId String

  checkIn  DateTime
  checkOut DateTime
  guests   Int      @default(1)
  status   BookingStatus @default(PENDING)
  priceAtBooking Decimal @db.Decimal(10, 2)
  notes    String?

  cancelledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User      @relation(fields: [userId], references: [id])
  hotel Hotel    @relation(fields: [hotelId], references: [id])
  room  HotelRoom @relation(fields: [roomId], references: [id])

  @@index([userId])
  @@index([hotelId])
  @@index([roomId])
  @@index([status])
  @@index([checkIn, checkOut])
}

// ============================================================
// RESTAURANT (RESTAURANT_OWNER)
// ============================================================

model Restaurant {
  id          String  @id @default(uuid())
  name        String
  description String?
  phone       String?
  address     String?
  location    String?
  imageUrl    String?
  capacity    Int     @default(20)
  openHours   String?
  isActive    Boolean @default(true)
  approvalStatus TourismApprovalStatus @default(PENDING)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  ownerId String
  cityId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User @relation(fields: [ownerId], references: [id])
  city     City? @relation(fields: [cityId], references: [id])
  bookings RestaurantBooking[]
  images   RestaurantImage[]
  menuItems RestaurantMenuItem[]
  partnerships BusinessPartnership[]

  @@index([ownerId])
  @@index([cityId])
  @@index([isActive])
  @@index([approvalStatus])
  @@index([isDeleted])
}

model RestaurantImage {
  id        String   @id @default(uuid())
  restaurantId String
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, sortOrder])
}

model RestaurantMenuItem {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  price        Decimal  @db.Decimal(12, 2)
  imageUrl     String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, sortOrder])
}

model RestaurantBooking {
  id           String @id @default(uuid())
  userId       String
  restaurantId String

  reservedAt DateTime
  guests     Int      @default(2)
  status     BookingStatus @default(PENDING)
  notes      String?

  cancelledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([userId])
  @@index([restaurantId])
  @@index([status])
  @@index([reservedAt])
}

// ============================================================
// FARM (FARM_OWNER)
// ============================================================

model Farm {
  id          String  @id @default(uuid())
  name        String
  description String?
  phone       String?
  address     String?
  location    String?
  imageUrl    String?
  capacity    Int     @default(30)
  amenities   String?
  isActive    Boolean @default(true)
  approvalStatus TourismApprovalStatus @default(PENDING)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  ownerId String
  cityId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User @relation(fields: [ownerId], references: [id])
  city     City? @relation(fields: [cityId], references: [id])
  bookings FarmBooking[]
  images   FarmImage[]
  partnerships BusinessPartnership[]

  @@index([ownerId])
  @@index([cityId])
  @@index([isActive])
  @@index([approvalStatus])
  @@index([isDeleted])
}

model FarmImage {
  id        String   @id @default(uuid())
  farmId    String
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([farmId, sortOrder])
}

model FarmBooking {
  id     String @id @default(uuid())
  userId String
  farmId String

  /// ÙØªØ±Ø© Ø§Ù„Ø­Ø¬Ø²: Ù…Ù†
  startAt DateTime
  /// ÙØªØ±Ø© Ø§Ù„Ø­Ø¬Ø²: Ø¥Ù„Ù‰
  endAt   DateTime
  /// Ù†ÙˆØ¹ Ø§Ù„Ù…Ù†Ø§Ø³Ø¨Ø©: Ø¹Ø§Ø¦Ù„Ø© / Ø´Ø¨Ø§Ø¨ / Ø¹Ø±Ø³ / Ø£Ø®Ø±Ù‰
  occasionType  FarmOccasionType @default(FAMILY)
  occasionOther String?

  guests Int           @default(2)
  status BookingStatus @default(PENDING)
  notes  String?

  cancelledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  @@index([userId])
  @@index([farmId])
  @@index([status])
  @@index([startAt, endAt])
}

// ============================================================
// BUSINESS PARTNERSHIP (Garage â†” Hotel/Restaurant/Farm)
// ============================================================

model BusinessPartnership {
  id String @id @default(uuid())

  garageId    String
  partnerType BusinessPartnerType
  hotelId      String?
  restaurantId String?
  farmId       String?

  status PartnershipStatus @default(PENDING)
  inviteMessage   String
  responseMessage String?
  isPublicOnDirectory Boolean @default(true)

  invitedByUserId   String
  respondedByUserId String?

  invitedAt   DateTime  @default(now())
  respondedAt DateTime?
  endedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  garage     Garage      @relation(fields: [garageId], references: [id], onDelete: Cascade)
  hotel      Hotel?      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  farm       Farm?       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  invitedBy  User @relation("PartnershipInviter", fields: [invitedByUserId], references: [id])
  respondedBy User? @relation("PartnershipResponder", fields: [respondedByUserId], references: [id])

  messages PartnershipMessage[]
  programLinks TourismProgramPartner[]

  @@index([garageId, status])
  @@index([hotelId, status])
  @@index([restaurantId, status])
  @@index([farmId, status])
  @@index([partnerType])
  @@index([status])
}

model PartnershipMessage {
  id            String @id @default(uuid())
  partnershipId String
  senderUserId  String
  body          String

  readAt    DateTime?
  createdAt DateTime @default(now())

  partnership BusinessPartnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  sender      User @relation(fields: [senderUserId], references: [id])

  @@index([partnershipId, createdAt])
  @@index([senderUserId])
}

// Site visit counter - singleton row id = "global"
model SiteStats {
  id         String   @id @default("global")
  visitCount Int      @default(0)
  updatedAt  DateTime @updatedAt
}